# Kopiera till .env och fyll i. .env committas aldrig.

# Databas (lokal Docker)
DATABASE_URL=postgres://zennode:zennode@localhost:5432/zennode_mote

# Bolagsverket – API för värdefulla datamängder (OAuth2 client credentials)
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=

# Brave Search API
BRAVE_SEARCH_API_KEY=

# AWS Bedrock (Claude, EU-inferensprofil)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=

# Berget AI (KB-Whisper, steg 2)
BERGET_API_KEY=

# Microsoft Graph (M7)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Langfuse (EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
